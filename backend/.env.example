DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Agen <noreply@agen.local>
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RATE_WINDOW_MINUTES=15
AUTH_CODE_EMAIL_LIMIT=5
AUTH_CODE_IP_LIMIT=20
# Optional local-only fixed code. Ignored when DJANGO_DEBUG=false.
AUTH_DEV_LOGIN_CODE=123456
# Development-only shortcut for testing business verification. Ignored when DJANGO_DEBUG=false.
BUSINESS_DEV_VERIFICATION_CODE=246810

# Personal agent model gateway
AGENT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_DEFAULT_MODEL=gpt-5-mini
AGENT_REASONING_MODEL=gpt-5.1
AGENT_VOICE_MODEL=gpt-realtime-mini
AGENT_EMBEDDING_MODEL=text-embedding-3-small
AGENT_MODEL_TIMEOUT_SECONDS=30

# Comma-separated Fernet keys. Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set this explicitly in production. The local development fallback derives a key from DJANGO_SECRET_KEY.
CONVERSATION_ENCRYPTION_KEYS=
